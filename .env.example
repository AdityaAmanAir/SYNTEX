# ==========================================
# AI-Powered Student Workspace Configuration
# ==========================================

# Server Network Settings
# Hosted on Port 80 (Standard HTTP) with automatic 8080 fallback
PORT=80
HOST=0.0.0.0

# Concurrency & CPU Utilization
# Leave blank to auto-detect hardware CPU cores * 2
SERVER_THREADS=

# Groq Ultra-Fast Inference Configuration
# Paste your Groq API key here:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic Claude API Configuration (Alternative Provider)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Operational Mode
# 0 = Production Mode (Uses Groq or Claude API)
# 1 = Local Testing Mode (Document-aware extractive notes, zero external calls)
MOCK_LLM=0

# System Limits
MAX_UPLOAD_MB=25
CHUNK_MAX_CHARS=6000
